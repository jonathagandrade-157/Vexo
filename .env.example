# Copy this file to .env.local and fill in real values for local development.
# .env.local is gitignored — never commit real secrets (see architecture §23).
#
# Only the variables actually wired up so far are declared here. The rest
# listed in docs/architecture/vexo-arquitetura-tecnica.md §23 (payment
# gateways, billing, shipping, email, Sentry, rate limiting, vault/API-key
# peppers, etc.) are added incrementally, in the stage that actually
# introduces the feature that needs them — not pre-declared as dead weight.

# --- Public (safe to expose to the browser; NEXT_PUBLIC_* only) ---

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STOREFRONT_DOMAIN_SUFFIX=vexo.local

# --- Private (server-only — never referenced from a client component) ---

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# HMAC key used only to hash CPF/CNPJ before storage (architecture §13) —
# never the document itself. Generate with: openssl rand -base64 32
TRIAL_HASH_SECRET=change-me-to-a-random-32-byte-value

# --- Mercado Pago (architecture §11) — validated separately from the vars
# above (lib/env.ts: getMercadoPagoEnv(), not getServerEnv()). Required
# only when a Mercado Pago action actually runs (connect/callback/webhook/
# checkout payment) — auth/cadastro/trial/onboarding never need these, so
# leaving them unset does not break account creation or login. ---

# From the app registered at https://www.mercadopago.com.br/developers.
# Use the SANDBOX app's credentials in dev/test, never the same app as
# production.
MERCADO_PAGO_CLIENT_ID=your-mercadopago-app-client-id
MERCADO_PAGO_CLIENT_SECRET=your-mercadopago-app-client-secret
# From the app's webhook configuration (used to verify x-signature).
MERCADO_PAGO_WEBHOOK_SECRET=your-mercadopago-webhook-secret
# HMAC key signing the OAuth `state` param. Generate with: openssl rand -base64 32
OAUTH_STATE_SECRET=change-me-to-a-random-32-byte-value

# --- Melhor Envio (D3.2-B) — SOMENTE conexão OAuth da conta do lojista
# nesta etapa (nenhuma cotação de frete ainda). Validado separadamente
# (lib/env.ts: getMelhorEnvioEnv()), pelo mesmo motivo do Mercado Pago
# acima. Reutiliza o mesmo OAUTH_STATE_SECRET já declarado acima. ---

# Do app registrado no painel do Melhor Envio. Use o app de SANDBOX em
# dev/test — nunca o mesmo app de produção.
MELHOR_ENVIO_CLIENT_ID=your-melhorenvio-app-client-id
MELHOR_ENVIO_CLIENT_SECRET=your-melhorenvio-app-client-secret
# "true" (padrão) usa https://sandbox.melhorenvio.com.br. "false" usa
# produção — a URL exata de produção não foi confirmada por acesso
# direto à documentação neste ambiente (rede bloqueada); reconfirmar em
# https://docs.melhorenvio.com.br/docs/autenticacao-1 antes de habilitar.
MELHOR_ENVIO_SANDBOX=true

# --- Billing (Etapa 20.2.5) — VEXO cobrando o LOJISTA pela assinatura do
# próprio VEXO. Validado separadamente (lib/env.ts: getBillingEnv()), pelo
# mesmo motivo do Mercado Pago acima: só exigido quando uma operação de
# billing de fato roda (lib/billing/registry.ts). Esta é a conta da VEXO
# no gateway, NUNCA a de um lojista — nunca reutilizar as variáveis do
# Mercado Pago acima nem dados de payment_credentials_vault aqui. ---

# API key da conta de Billing da VEXO no Asaas. Use a chave de SANDBOX em
# dev/test (https://sandbox.asaas.com) — nunca a de produção fora do
# ambiente de produção real.
ASAAS_API_KEY=your-asaas-account-api-key
# Sandbox: https://sandbox.asaas.com/api/v3 — produção: reconfirmar a URL
# exata em https://docs.asaas.com/docs/sandbox antes de configurar.
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
# Token estático configurado na criação do webhook no Asaas — enviado de
# volta no header `asaas-access-token` de toda chamada (Etapa 20.2.8).
ASAAS_WEBHOOK_TOKEN=change-me-to-the-token-asaas-generated-for-this-webhook

# --- Vercel Domains API (D17.5.1) — binding do domínio customizado do
# lojista (já verificado via DNS TXT, D17.3) ao projeto Vercel do VEXO.
# Validado separadamente (lib/env.ts: getVercelEnv()), pelo mesmo motivo do
# Mercado Pago acima: só exigido quando o lojista de fato conecta um
# domínio na Vercel (features/settings/domain-vercel-actions.ts) — nunca
# por auth/cadastro/trial/onboarding/checkout/Host Routing. ---

# Access Token da Vercel (formato vca_...), com escopo restrito ao team do
# VEXO (nunca um token de conta pessoal/todas as teams).
VERCEL_API_TOKEN=your-vercel-access-token
# Sempre o projeto/team fixos e já confirmados do VEXO — nunca resolvidos
# dinamicamente por nome/busca (ver lib/vercel/domains.ts).
VERCEL_PROJECT_ID=your-vercel-project-id
VERCEL_TEAM_ID=your-vercel-team-id

# --- Sentry (JON-14) — observabilidade de erros (arquitetura §21).
# Diferente das integrações acima, NÃO é validado por lib/env.ts: os
# arquivos de bootstrap do SDK (instrumentation-client.ts,
# sentry.server.config.ts, sentry.edge.config.ts) leem process.env
# diretamente, e Sentry.init() com dsn ausente vira no-op sem quebrar o
# app — mesmo princípio de "nenhuma integração opcional derruba um fluxo
# essencial", só que resolvido pelo próprio SDK em vez de um getter
# próprio. beforeSend (lib/sentry/scrub-event.ts) redige campos sensíveis
# por nome antes de qualquer envio (arquitetura §11.1: credencial de
# gateway/cookie/token nunca chega ao Sentry). ---

# DSN do projeto Sentry — não é segredo (só permite ENVIAR eventos, nunca
# ler), mas NEXT_PUBLIC_* porque instrumentation-client.ts (bundle do
# browser) também precisa dele.
NEXT_PUBLIC_SENTRY_DSN=https://your-key@oXXXXXX.ingest.us.sentry.io/XXXXXXX
# Usados só em build time por withSentryConfig (next.config.ts) para
# subir source maps — nunca lidos pelo app em runtime.
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
# De https://sentry.io/orgredirect/organizations/:org/settings/auth-tokens/ — nunca comitar o valor real.
SENTRY_AUTH_TOKEN=your-sentry-auth-token
