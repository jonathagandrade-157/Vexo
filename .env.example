# Copy this file to .env.local and fill in real values for local development.
# .env.local is gitignored — never commit real secrets (see architecture §23).
#
# Only the variables actually wired up so far are declared here. The rest
# listed in docs/architecture/vexo-arquitetura-tecnica.md §23 (payment
# gateways, billing, shipping, email, Sentry, rate limiting, vault/API-key
# peppers, etc.) are added incrementally, in the stage that actually
# introduces the feature that needs them — not pre-declared as dead weight.

# --- Public (safe to expose to the browser; NEXT_PUBLIC_* only) ---

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STOREFRONT_DOMAIN_SUFFIX=vexo.local

# --- Private (server-only — never referenced from a client component) ---

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# HMAC key used only to hash CPF/CNPJ before storage (architecture §13) —
# never the document itself. Generate with: openssl rand -base64 32
TRIAL_HASH_SECRET=change-me-to-a-random-32-byte-value
