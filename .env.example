# Copy this file to .env.local and fill in real values for local development.
# .env.local is gitignored — never commit real secrets (see architecture §23).
#
# This Foundation stage only wires up the variables below. The remaining
# variables listed in docs/architecture/vexo-arquitetura-tecnica.md §23
# (trial hashing, payment gateways, billing, shipping, email, Sentry, rate
# limiting, vault/API-key peppers, etc.) are added incrementally, in the
# stage that actually introduces the feature that needs them — they are not
# pre-declared here as dead weight.

# --- Public (safe to expose to the browser; NEXT_PUBLIC_* only) ---

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STOREFRONT_DOMAIN_SUFFIX=vexo.local

# --- Private (server-only — never referenced from a client component) ---

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
