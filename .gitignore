# Env files — never commit real secrets.
# .env.example is the only env file tracked in git.
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# Supabase CLI local state (never commit local DB dumps/branches)
supabase/.branches/
supabase/.temp/

# OS / editor
.DS_Store
*.pem
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
